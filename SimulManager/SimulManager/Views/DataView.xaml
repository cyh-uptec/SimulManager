<UserControl x:Class="SimulManager.Views.DataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="http://schemas.abtsoftware.co.uk/scichart"
             xmlns:local="clr-namespace:SimulManager.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />

        <!-- 세그먼트 버튼 (.segmented) -->
        <Style x:Key="SegBtn" TargetType="Button">
            <Setter Property="Padding" Value="20,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegBtnOn" TargetType="Button" BasedOn="{StaticResource SegBtn}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource IndigoBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BgBrush}">
        <StackPanel Margin="28,26">

            <!-- topbar -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                <TextBlock Text="데이터" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}" Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <!-- 업로드 카드 2개 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="부하 데이터" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Left" />
                            <Button Content="{Binding LoadButtonText}" Style="{StaticResource BtnSmall}"
                                    HorizontalAlignment="Right" Command="{Binding UploadLoadCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding LoadMetaText}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="기상 데이터" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Left" />
                            <Button Content="{Binding WeatherButtonText}" Style="{StaticResource BtnSmall}"
                                    HorizontalAlignment="Right" Command="{Binding UploadWeatherCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding WeatherMetaText}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 차트 카드 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Border Background="{StaticResource TrackBrush}" CornerRadius="10" Padding="3"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="부하" Command="{Binding SelectLoadCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SegBtn}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoadKind}" Value="True">
                                                    <Setter Property="Background" Value="White" />
                                                    <Setter Property="Foreground" Value="{StaticResource IndigoBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="기상" Command="{Binding SelectWeatherCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SegBtn}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoadKind}" Value="False">
                                                    <Setter Property="Background" Value="White" />
                                                    <Setter Property="Foreground" Value="{StaticResource IndigoBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding ColumnChecks}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource Check}" Content="{Binding Label}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <TextBlock Text="{Binding ChartEmptyText}" Style="{StaticResource Muted}"
                               TextAlignment="Center" Padding="0,40"
                               Visibility="{Binding ChartEmpty, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Visibility="{Binding ChartEmpty, Converter={StaticResource InvBoolToVis}}">
                        <s:SciChartSurface x:Name="DataChart" Height="300"
                                           s:ThemeManager.Theme="BrightSpark" BorderThickness="0">
                            <s:SciChartSurface.XAxis>
                                <s:DateTimeAxis DrawMajorGridLines="True" DrawMinorGridLines="False"
                                                TextFormatting="MM-dd HH:mm" />
                            </s:SciChartSurface.XAxis>
                            <s:SciChartSurface.YAxis>
                                <s:NumericAxis GrowBy="0.05,0.05" DrawMajorGridLines="True"
                                               DrawMinorGridLines="False" />
                            </s:SciChartSurface.YAxis>
                            <s:SciChartSurface.ChartModifier>
                                <s:ModifierGroup>
                                    <s:LegendModifier ShowLegend="True" Orientation="Horizontal"
                                                      LegendPlacement="Inside" Margin="6" />
                                    <s:RolloverModifier ShowTooltipOn="MouseHover" />
                                </s:ModifierGroup>
                            </s:SciChartSurface.ChartModifier>
                        </s:SciChartSurface>
                        <TextBlock Text="{Binding ChartNote}" Style="{StaticResource Muted}" FontSize="11.5"
                                   HorizontalAlignment="Right" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 기상 이벤트 카드 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="기상 이벤트 (폭염·폭설)" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Left" />
                        <TextBlock Text="운영자 임의 입력 — 가상 기간 지정, 양 Run 동일 적용"
                                   Style="{StaticResource Muted}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <WrapPanel Margin="0,0,0,14">
                        <ComboBox Style="{StaticResource InputCombo}" Width="140" Margin="0,0,8,0"
                                  SelectedIndex="{Binding EventTypeIsSnow, Mode=TwoWay,
                                                  Converter={x:Static local:BoolToIndexConverter.Instance}}">
                            <ComboBoxItem Content="폭염 (코드 1)" />
                            <ComboBoxItem Content="폭설 (코드 2)" />
                        </ComboBox>
                        <TextBox Style="{StaticResource InputText}" Width="160" Margin="0,0,4,0"
                                 Text="{Binding EventStart, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="시작 가상시각 (예: 2025-07-03 12:00)" />
                        <TextBlock Text="~" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0" />
                        <TextBox Style="{StaticResource InputText}" Width="160" Margin="4,0,8,0"
                                 Text="{Binding EventEnd, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="종료 가상시각 (예: 2025-07-04 00:00)" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                                    Visibility="{Binding EventTypeIsSnow, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="적설" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBox Style="{StaticResource InputText}" Width="64"
                                     Text="{Binding SnowCm, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="cm" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                        <Button Content="+ 추가" Style="{StaticResource BtnPrimary}" Padding="16,8"
                                Command="{Binding AddEventCommand}" />
                        <TextBlock Text="{Binding EventError}" Style="{StaticResource ErrorText}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   Visibility="{Binding HasEventError, Converter={StaticResource BoolToVis}}" />
                    </WrapPanel>
                    <TextBlock Text="등록된 이벤트가 없습니다 — 기본은 정상(코드 0)입니다."
                               Style="{StaticResource Muted}"
                               Visibility="{Binding EventsEmpty, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Border Margin="0,0,10,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                    <Setter Property="Background" Value="{StaticResource SnowSoftBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHeatwave}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource RedSoftBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TypeLabel}" FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource SnowTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHeatwave}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource RedTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding RangeText}" Style="{StaticResource Muted}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Content="삭제" Style="{StaticResource BtnSmall}" Padding="12,4"
                                            FontSize="12" HorizontalAlignment="Right"
                                            Command="{Binding DataContext.RemoveEventCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 데이터 표 -->
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding TableVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DataGrid x:Name="RowsGrid" Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridHeader}"
                              ItemsSource="{Binding TableView}" AutoGenerateColumns="True"
                              Sorting="RowsGrid_Sorting" MaxHeight="520"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    <Grid Margin="0,12,0,0">
                        <Button Content="← 이전" Style="{StaticResource BtnSmall}" HorizontalAlignment="Left"
                                Command="{Binding PrevPageCommand}" />
                        <TextBlock Text="{Binding PagerText}" Style="{StaticResource Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Content="다음 →" Style="{StaticResource BtnSmall}" HorizontalAlignment="Right"
                                Command="{Binding NextPageCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
