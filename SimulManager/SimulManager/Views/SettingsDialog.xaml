<dx:ThemedWindow x:Class="SimulManager.Views.SettingsDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 Title="시뮬레이션 설정" Width="640" SizeToContent="Height"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                 Background="{StaticResource BgBrush}">
    <Border Style="{StaticResource Card}" Margin="14">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <TextBlock Text="시뮬레이션 설정" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Left" />
                <Button Content="✕" Style="{StaticResource BtnSmall}" Padding="10,6"
                        HorizontalAlignment="Right" Click="Close_Click" />
            </Grid>

            <Border x:Name="NoticeBar" Background="{StaticResource AmberSoftBrush}" CornerRadius="8"
                    Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock Text="운전 중에는 설정을 변경할 수 없습니다 — 정지 후 되감기 하세요."
                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AmberTextBrush}" />
            </Border>

            <UniformGrid Columns="2" Margin="0,0,0,6">
                <StackPanel Margin="0,0,9,14">
                    <TextBlock Text="가상 시작시각" Style="{StaticResource Label}" Margin="0,0,0,5" />
                    <TextBox x:Name="StartBox" Style="{StaticResource InputText}"
                             ToolTip="yyyy-MM-dd HH:mm" />
                </StackPanel>
                <StackPanel Margin="9,0,0,14">
                    <TextBlock Text="시뮬레이션 기간 (일)" Style="{StaticResource Label}" Margin="0,0,0,5" />
                    <TextBox x:Name="DaysBox" Style="{StaticResource InputText}" />
                </StackPanel>
                <StackPanel Margin="0,0,9,14">
                    <TextBlock Text="시간 가속 배율 (실 초 = 가상 15분)" Style="{StaticResource Label}" Margin="0,0,0,5" />
                    <TextBox x:Name="AccelBox" Style="{StaticResource InputText}" />
                    <TextBlock Text="1~900초 — 예: 10이면 1 Run ≈ 실 8시간" Style="{StaticResource Muted}"
                               FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Margin="9,0,0,14">
                    <TextBlock Text="초기 SOC (%)" Style="{StaticResource Label}" Margin="0,0,0,5" />
                    <TextBox x:Name="InitialSocBox" Style="{StaticResource InputText}" />
                    <TextBlock Text="양 Run 동일 주입 (공정 비교)" Style="{StaticResource Muted}"
                               FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Margin="0,0,9,14">
                    <TextBlock Text="SOC 운전 상한 (%)" Style="{StaticResource Label}" Margin="0,0,0,5" />
                    <TextBox x:Name="SocMaxBox" Style="{StaticResource InputText}" />
                </StackPanel>
                <StackPanel Margin="9,0,0,14">
                    <TextBlock Text="SOC 운전 하한 (%)" Style="{StaticResource Label}" Margin="0,0,0,5" />
                    <TextBox x:Name="SocMinBox" Style="{StaticResource InputText}" />
                </StackPanel>
                <StackPanel Margin="0,0,9,14">
                    <TextBlock Text="충전량 제한 (kW)" Style="{StaticResource Label}" Margin="0,0,0,5" />
                    <TextBox x:Name="ChargeBox" Style="{StaticResource InputText}" />
                </StackPanel>
                <StackPanel Margin="9,0,0,14">
                    <TextBlock Text="방전량 제한 (kW)" Style="{StaticResource Label}" Margin="0,0,0,5" />
                    <TextBox x:Name="DischargeBox" Style="{StaticResource InputText}" />
                </StackPanel>
            </UniformGrid>

            <Grid Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
                    <TextBlock x:Name="SavedText" Text="저장되었습니다" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TealTextBrush}" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="취소" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="Close_Click" />
                    <Button x:Name="SaveButton" Content="저장" Style="{StaticResource BtnPrimary}"
                            Click="Save_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</dx:ThemedWindow>
