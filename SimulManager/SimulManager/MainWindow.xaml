<dx:ThemedWindow
    x:Class="SimulManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
    xmlns:Views="clr-namespace:SimulManager.Views"
    Title="SimulManager — HILS 시뮬레이션 매니저" Height="900" Width="1500"
    WindowStartupLocation="CenterScreen">
    <dx:ThemedWindow.Resources>
        <Views:EqualsToVisibilityConverter x:Key="PageVis" />

        <!-- 흰색 패널용 메뉴 버튼 스타일 — 기본 템플릿은 어두운 패널 전제(흰 글씨)라 재정의 -->
        <Style TargetType="{x:Type dxwui:HamburgerMenuNavigationButton}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="GlyphWidth" Value="20" />
            <Setter Property="GlyphHeight" Value="20" />
            <Setter Property="AllowGlyphTheming" Value="False" />
            <Style.Triggers>
                <!-- 선택 항목은 어두운 액센트 배경 위 — 흰 글씨/아이콘 (웹 active 스타일과 동일) -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsSelected" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type dxwui:HamburgerMenuHyperlinkButton}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <!-- ☰ 토글 버튼 — 흰 패널 위에서 보이도록 어두운 색 지정 -->
        <Style TargetType="{x:Type dxwui:HamburgerMenuToggleStateButton}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <!-- 벡터 아이콘 글리프 (선 아이콘, 버튼 Foreground 색 상속) -->
        <Style x:Key="GlyphPath" TargetType="Path">
            <Setter Property="Stroke"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type dxwui:HamburgerMenuNavigationButton}}}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="IconHome">
            <Path Style="{StaticResource GlyphPath}"
                  Data="M3,10.5 L12,3 L21,10.5 M5,9 L5,20 L19,20 L19,9 M10,20 L10,14 L14,14 L14,20" />
        </DataTemplate>
        <DataTemplate x:Key="IconMonitor">
            <Path Style="{StaticResource GlyphPath}"
                  Data="M3,3 L3,21 L21,21 M6.5,16 L10.5,10.5 L13.5,13.5 L19,6.5" />
        </DataTemplate>
        <DataTemplate x:Key="IconData">
            <Path Style="{StaticResource GlyphPath}"
                  Data="M4,4 L20,4 L20,20 L4,20 Z M4,9.5 L20,9.5 M10,4 L10,20" />
        </DataTemplate>
        <DataTemplate x:Key="IconSequence">
            <Path Style="{StaticResource GlyphPath}"
                  Data="M9,5.5 L20,5.5 M9,12 L20,12 M9,18.5 L20,18.5 M4.4,5.5 L4.6,5.5 M4.4,12 L4.6,12 M4.4,18.5 L4.6,18.5" />
        </DataTemplate>
    </dx:ThemedWindow.Resources>

    <dxwui:HamburgerMenu x:Name="Menu"
                         OpenPaneWidth="210"
                         IsInitiallyCompact="False"
                         IsMenuVisible="True"
                         PaneBackground="White"
                         Foreground="#232D47"
                         HeaderForeground="#4F46E5"
                         HeaderFontSize="19">
        <dxwui:HamburgerMenu.Header>SimulManager</dxwui:HamburgerMenu.Header>
        <dxwui:HamburgerMenu.Items>
            <dxwui:HamburgerMenuNavigationButton x:Name="NavHome" Content="Home" Tag="home"
                                                 IsSelected="True" Click="Nav_Click"
                                                 GlyphTemplate="{StaticResource IconHome}" />
            <dxwui:HamburgerMenuNavigationButton x:Name="NavMonitor" Content="모니터링" Tag="monitor"
                                                 Click="Nav_Click"
                                                 GlyphTemplate="{StaticResource IconMonitor}" />
            <dxwui:HamburgerMenuNavigationButton x:Name="NavData" Content="데이터" Tag="data"
                                                 Click="Nav_Click"
                                                 GlyphTemplate="{StaticResource IconData}" />
            <dxwui:HamburgerMenuNavigationButton x:Name="NavSequence" Content="시퀀스" Tag="sequence"
                                                 Click="Nav_Click"
                                                 GlyphTemplate="{StaticResource IconSequence}" />
            <dxwui:HamburgerMenuHyperlinkButton Content="HILS 시뮬레이션 매니저" Placement="Bottom" />
        </dxwui:HamburgerMenu.Items>

        <!-- 콘텐츠 — 페이지 전환 -->
        <dxwui:HamburgerMenu.Content>
        <Grid Background="{StaticResource BgBrush}">
            <Views:HomeView DataContext="{Binding Home}"
                            Visibility="{Binding DataContext.CurrentPage,
                                         RelativeSource={RelativeSource AncestorType=dx:ThemedWindow},
                                         Converter={StaticResource PageVis}, ConverterParameter=home}" />
            <Views:MonitorView DataContext="{Binding Monitor}"
                               Visibility="{Binding DataContext.CurrentPage,
                                            RelativeSource={RelativeSource AncestorType=dx:ThemedWindow},
                                            Converter={StaticResource PageVis}, ConverterParameter=monitor}" />
            <Views:DataView DataContext="{Binding Data}"
                            Visibility="{Binding DataContext.CurrentPage,
                                         RelativeSource={RelativeSource AncestorType=dx:ThemedWindow},
                                         Converter={StaticResource PageVis}, ConverterParameter=data}" />
            <Views:SequenceView DataContext="{Binding Sequence}"
                                Visibility="{Binding DataContext.CurrentPage,
                                             RelativeSource={RelativeSource AncestorType=dx:ThemedWindow},
                                             Converter={StaticResource PageVis}, ConverterParameter=sequence}" />
        </Grid>
        </dxwui:HamburgerMenu.Content>
    </dxwui:HamburgerMenu>
</dx:ThemedWindow>
