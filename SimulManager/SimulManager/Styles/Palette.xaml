<!-- 디자인 팔레트·공통 스타일 — frontend/src/index.css 포팅
     Adobe Stock 대시보드 팔레트 — 라이트 톤 · 리니어(그라데이션) 스타일 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── 색상 (:root 변수) ── -->
    <Color x:Key="BgColor">#F2F5FB</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E8ECF5</Color>
    <Color x:Key="TextColor">#232D47</Color>
    <Color x:Key="MutedColor">#8A94AD</Color>
    <Color x:Key="IndigoColor">#4F46E5</Color>
    <Color x:Key="IndigoSoftColor">#EEF0FE</Color>
    <Color x:Key="BlueColor">#38BDF8</Color>
    <Color x:Key="TealColor">#2EC5B6</Color>
    <Color x:Key="TealSoftColor">#E7F9F6</Color>
    <Color x:Key="AmberColor">#FFB020</Color>
    <Color x:Key="AmberSoftColor">#FFF6E3</Color>
    <Color x:Key="RedColor">#F26D6D</Color>
    <Color x:Key="RedSoftColor">#FDEEEE</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="IndigoBrush" Color="{StaticResource IndigoColor}" />
    <SolidColorBrush x:Key="IndigoSoftBrush" Color="{StaticResource IndigoSoftColor}" />
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" />
    <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
    <SolidColorBrush x:Key="TealSoftBrush" Color="{StaticResource TealSoftColor}" />
    <SolidColorBrush x:Key="TealTextBrush" Color="#0D9F92" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="AmberSoftBrush" Color="{StaticResource AmberSoftColor}" />
    <SolidColorBrush x:Key="AmberTextBrush" Color="#C07F00" />
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}" />
    <SolidColorBrush x:Key="RedSoftBrush" Color="{StaticResource RedSoftColor}" />
    <SolidColorBrush x:Key="RedTextBrush" Color="#D64545" />
    <SolidColorBrush x:Key="ChipBrush" Color="#F1F3FA" />
    <SolidColorBrush x:Key="TrackBrush" Color="#EDF0F8" />
    <SolidColorBrush x:Key="SnowSoftBrush" Color="#E8F0FE" />
    <SolidColorBrush x:Key="SnowTextBrush" Color="#2563EB" />

    <!-- grad-main: linear-gradient(135deg, #6366f1 0%, #38bdf8 100%) -->
    <LinearGradientBrush x:Key="GradMainBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0" />
        <GradientStop Color="#38BDF8" Offset="1" />
    </LinearGradientBrush>
    <!-- grad-bar: linear-gradient(90deg, #6366f1 0%, #38bdf8 55%, #2ec5b6 100%) -->
    <LinearGradientBrush x:Key="GradBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#6366F1" Offset="0" />
        <GradientStop Color="#38BDF8" Offset="0.55" />
        <GradientStop Color="#2EC5B6" Offset="1" />
    </LinearGradientBrush>

    <!-- shadow: 0 6px 24px rgba(76,87,125,0.09) -->
    <DropShadowEffect x:Key="CardShadow" Color="#4C577D" Opacity="0.13" BlurRadius="24"
                      ShadowDepth="4" Direction="270" />

    <!-- ── 카드 ── -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="MinHeight" Value="158" />
    </Style>

    <!-- ── 텍스트 ── -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource GradMainBrush}" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ValueText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ── 버튼 (.btn) ── -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Padding" Value="20,11" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#C3C9F8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{StaticResource GradMainBrush}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BtnSmall" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ── 배지 (.badge) ── -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Background" Value="{StaticResource ChipBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <!-- ── 입력 ── -->
    <Style x:Key="Input" TargetType="Control">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="InputText" TargetType="TextBox" BasedOn="{StaticResource Input}" />
    <Style x:Key="InputCombo" TargetType="ComboBox">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ── 체크박스 ── -->
    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- ── 데이터 표 (.data-table) ── -->
    <Style x:Key="DataGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#F1F3FA" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="34" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
    </Style>
    <Style x:Key="DataGridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ── 시퀀스 로그 페이즈 칩 ── -->
    <Style x:Key="PhaseChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="Background" Value="{StaticResource IndigoSoftBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PhaseChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource IndigoBrush}" />
    </Style>
</ResourceDictionary>
